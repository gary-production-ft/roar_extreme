PORT=5000
NODE_ENV=development

MONGO_URI=mongodb://127.0.0.1:27017/roar_extreme

CLIENT_URL=http://localhost:5173

# JWT Authentication (Rotated production key required; max 8h lifetime)
JWT_SECRET=replace_with_secure_random_secret_at_least_32_chars
JWT_EXPIRES_IN=8h

# Initial Admin Provisioning (Used during npm run create-admin)
ADMIN_EMAIL=admin@roarextreme.com
ADMIN_PASSWORD=replace_with_strong_password_min_8_chars
ADMIN_ROLE=owner

# Biometric Face Recognition & AES-256-GCM Encryption
# Provide a 32-character string or 64-character hex key
FACE_ENCRYPTION_KEY=roar_biometric_aes256_secret_key_32bytes!
FACE_MATCH_THRESHOLD=0.48
AMBIGUITY_MARGIN=0.08
DEVICE_API_KEY=roar_kiosk_device_key_nashik_rooftop_01
ATTENDANCE_COOLDOWN_MINUTES=5
GRACE_PERIOD_DAYS=0

# Phase 2 Hardware Turnstile & Door Control
# MQTT Broker (Managed TLS broker e.g., HiveMQ Cloud / AWS IoT / EMQX Cloud)
# Leave empty or set to 'simulated' to use zero-config in-memory mock transport for testing
MQTT_BROKER_URL=mqtts://your-cluster-id.s1.eu.hivemq.cloud:8883
MQTT_USERNAME=roar_esp32_gateway
MQTT_PASSWORD=replace_with_strong_mqtt_password
LOCK_DEVICE_SECRET=roar_esp32_lock_hmac_secret_key_2026!
DOOR_COMMAND_EXPIRY_MS=5000
DEVICE_HEARTBEAT_TIMEOUT_MS=45000

AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

RESEND_API_KEY=your_resend_api_key_or_leave_empty_for_mock
FROM_EMAIL=noreply@roarextreme.com
GYM_NOTIFICATION_EMAIL=admin@roarextreme.com

MEMORY_ENABLED=true
CHAT_HISTORY_RETENTION_DAYS=30
MEMORY_RETENTION_DAYS=180
